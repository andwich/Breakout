[physics]

common/2d/solver/solver_type=0
2d/layer_names/1="paddle"
2d/layer_names/2="ball"
2d/layer_names/3="brick"
2d/layer_names/4="powerup"
2d/layer_names/5="laser"
2d/layer_names/6="wall"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/sdf/oversizing=1.0

[gui]

theme/custom_font="res://assets/fonts/Mono-Bold.ttf"